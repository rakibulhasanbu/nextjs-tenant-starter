# The API's apex origin. Pages on <slug>.<root> / admin.<root> mirror their own
# hostname onto this origin's scheme + port, because the API resolves the tenant
# from the request host (acme.localhost:3001 -> acme.localhost:3000).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Must match the backend's APP_ROOT_DOMAIN and PLATFORM_SUBDOMAIN.
NEXT_PUBLIC_ROOT_DOMAIN=localhost
NEXT_PUBLIC_PLATFORM_SUBDOMAIN=admin
# Mirror the backend's JWT_REFRESH_TTL (nestjs-starter defaults to 30d).
NEXT_PUBLIC_REFRESH_TOKEN_TTL_DAYS=30
#
# Backend .env needed alongside this (web on :3001, API on :3000):
#   APP_ROOT_DOMAIN=localhost
#   PLATFORM_SUBDOMAIN=admin
#   TENANT_URL_TEMPLATE=http://{slug}.localhost:3001
#   CORS_ORIGINS=http://localhost:3001
